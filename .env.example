# --- core (Python service and CLI) ---
TYPESAFE_API_KEY=            # console.typesafe.ai key, or an OpenRouter key (see below)
SWE_AGENT_JEV_MODEL=jev-1.13
# Jev through OpenRouter instead of TypeSafe directly (same API, same schema):
# SWE_AGENT_JEV_BASE_URL=https://openrouter.ai/api   # then TYPESAFE_API_KEY=<your OpenRouter key>
GITHUB_TOKEN=                # repo scope; opens PRs, comments, and (watchdog) notice issues
ANTHROPIC_API_KEY=           # the LLM behind OpenHands (skip if you use a gateway below)
SWE_AGENT_API_TOKEN=         # shared secret: gateway -> core
SWE_AGENT_REPO_ALLOWLIST=["owner/repo"]
# Optional: route the agent's LLM through OmniRoute (or any OpenAI-compatible gateway)
# SWE_AGENT_LLM_BASE_URL=http://172.17.0.1:20128/v1   # reachable from inside Docker, see README
# SWE_AGENT_LLM_API_KEY=                              # key from the OmniRoute dashboard
# SWE_AGENT_AGENT_MODEL=openai/<model-or-combo-name>
# Optional
# SWE_AGENT_AGENT_MODEL=anthropic/claude-sonnet-5-5
# SWE_AGENT_TEST_COMMAND=python -m pytest -q   # default: detected from the repo
# SWE_AGENT_MAX_ITERATIONS=100
# SWE_AGENT_DB_PATH=swe_agent.db
# SWE_AGENT_SMTP_HOST=  SWE_AGENT_SMTP_FROM=  SWE_AGENT_DIGEST_TO=   # watchdog email digest

# --- gateway (TypeScript webhook receiver) ---
GITHUB_WEBHOOK_SECRET=       # same secret you set on the GitHub webhook
CORE_URL=http://127.0.0.1:8000
CORE_API_TOKEN=              # = SWE_AGENT_API_TOKEN
# GITHUB_TOKEN is reused for status comments
# TRIGGER_LABEL=ai-fix
# PORT=3000
